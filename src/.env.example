# Cấu hình ứng dụng Flask
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key

# Cơ sở dữ liệu (mặc định tự động dùng SQLite tại instance/luxauto.db nếu để trống)
# DATABASE_URL=sqlite:///instance/luxauto.db

# Cấu hình SMTP gửi email (Flask-Mail / Mailtrap / Gmail App Password)
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=LuxAuto Showroom <noreply@luxauto.vn>
# Chế độ chạy demo: bật MAIL_SUPPRESS_SEND=true để ghi nhận email an toàn mà không cần tài khoản SMTP thật
MAIL_SUPPRESS_SEND=true
MAIL_DEBUG=true

# Cấu hình API tỷ giá ngoại tệ (ExchangeRate-API)
# Nếu để trống, hệ thống tự động gọi endpoint mở miễn phí open.er-api.com (không cần key)
EXCHANGE_API_KEY=
EXCHANGE_API_TIMEOUT=5

# Giới hạn dung lượng upload ảnh (MB) & phân trang
MAX_CONTENT_LENGTH_MB=10
CARS_PER_PAGE=6
