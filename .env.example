# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key

# MySQL 8 Database (utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=solvang_motors
DB_USER=root
DB_PASSWORD=your_mysql_password
# Hoặc cấu hình trực tiếp DATABASE_URL (nếu đặt, biến này sẽ được ưu tiên)
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/solvang_motors?charset=utf8mb4

# Upload limits (MB)
MAX_CONTENT_LENGTH_MB=25

# Asset Fetcher API Keys (optional - free tiers)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
SKETCHFAB_TOKEN=
STORE_IMAGES_IN_DB=false
